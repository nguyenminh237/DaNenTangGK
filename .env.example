# Firebase Web App configuration (Firebase Console > Project settings).
# EXPO_PUBLIC_* is visible in the app bundle. Never put server credentials here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# UID from Firebase Authentication > Users, matching the UID in Firestore Rules.
# This is public configuration, never put the admin password here.
EXPO_PUBLIC_ADMIN_UID=

# Cloudinary unsigned uploads. Never add an API secret to EXPO_PUBLIC_*.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
