// Sao chép vào Firebase Console > Firestore > Rules, kiểm tra UID rồi Publish.
// UID này lấy từ Rules đã được chủ dự án cung cấp; phải khớp EXPO_PUBLIC_ADMIN_UID.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'O2FpJ6939gPzQ0ztD15D4VdAwp23';
    }
    function validUser() {
      let data = request.resource.data;
      return data.keys().hasAll(['email', 'matkhau', 'hoten', 'hinhanh'])
        && data.keys().hasOnly(['email', 'matkhau', 'hoten', 'hinhanh'])
        && data.email is string
        && data.matkhau is string
        && data.hoten is string
        && data.hinhanh is string
        && data.hinhanh.matches('^https://[^ ]+$')
        && data.matkhau.matches('^[$]2b[$]12[$][./A-Za-z0-9]{53}$');
    }
    match /users/{userId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validUser();
    }
  }
}
